(|-1> = 1/s2 (|1.7>+i*|1.6>))
(| 1> = 1/s2 (|1.7>-i*|1.6>))

(< 1.4|LSX| 1> = 1/s2*( -i*i*a ) = 1/s2*a )
(< 1.4|LSX|-1> = 1/s2*( i*i*a ) = -1/s2*a )
(< 1.4|LSY| 1> = 1/s2*( -a ) = -a/s2 )
(< 1.4|LSY|-1> = 1/s2*( -a ) = -a/s2 )

(< 1.4,0|LSX+LSY| 1 1> = 1/s2*(  a-a ) =  0   )
(< 1.4,0|LSX+LSY|-1 1> = 1/s2*( -a-a ) = -a*s2)

(< 1.4,0|LSX+LSY| 1 -1> = 1/s2*(  a+a ) = a*s2 )
(< 1.4,0|LSX+LSY|-1 -1> = 1/s2*( -a+a ) =  0   )


(< 1.4,-1|LSX+LSY| 1 0> = 1/s2*(  a-a ) =  0   )
(< 1.4,-1|LSX+LSY|-1 0> = 1/s2*( -a-a ) = -a*s2)

(< 1.4, 1|LSX+LSY| 1 0> = 1/s2*(  a+a ) =  a*s2)
(< 1.4, 1|LSX+LSY|-1 0> = 1/s2*( -a+a ) =  0   )


